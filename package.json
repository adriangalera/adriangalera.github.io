{
	"name": "agalera.eu",
	"type": "module",
	"version": "1.1.0",
	"description": "My personal blog",
	"author": "Adrian galera",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/adriangalera/adriangalera.github.io"
	},
	"keywords": [
		"astro",
		"astrojs",
		"astro-template",
		"astro-blog",
		"astro-b"
	],
	"scripts": {
		"dev": "npx tinacms dev -c \"astro dev\"",
		"dev:host": "npx tinacms dev -c \"astro dev --host\"",
		"start": "astro dev",
		"build": "vitest --no-watch && astro build",
		"sync": "astro sync",
		"preview": "astro preview",
		"preview:host": "astro preview --host",
		"postbuild": "pagefind --site dist",
		"format:check": "prettier --plugin-search-dir=. --check .",
		"format": "prettier --plugin-search-dir=. --write .",
		"pre-commit": "lint-staged",
		"prepare": "husky install",
		"deploy": "npm run build && gh-pages -d dist --branch gh-pages --dotfiles",
		"compare-sitemaps": "node scripts/compare-sitemaps.cjs",
		"test": "vitest --no-watch"
	},
	"dependencies": {
		"@astrojs/rss": "^4.0.19",
		"astro": "^7.4.5"
	},
	"devDependencies": {
		"@astrojs/markdown-remark": "^7.3.5",
		"@astrojs/mdx": "^8.1.2",
		"@astrojs/sitemap": "^3.7.4",
		"@pagefind/default-ui": "^1.6.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"@tinacms/cli": "^4.0.4",
		"clsx": "^2.1.1",
		"gh-pages": "^6.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"mdast-util-to-string": "^4.0.0",
		"motion": "^14.9.1",
		"pagefind": "^1.6.0",
		"prettier": "^3.9.10",
		"prettier-config-standard": "^7.0.0",
		"prettier-plugin-astro": "^1.1.2",
		"reading-time": "^1.5.0",
		"slugify": "^1.6.9",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.4",
		"tinacms": "^3.15.1",
		"typescript": "^5.9.3",
		"vitest": "^5.1.0",
		"xml2json": "^0.12.0"
	},
	"lint-staged": {
		"*.{astro,js,jsx,ts,tsx,md,mdx,json}": [
			"prettier --write --plugin-search-dir=."
		]
	},
	"engines": {
		"node": ">=22.23.4"
	}
}
